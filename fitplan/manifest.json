{
  "name": "FitPlan – Abnehmen",
  "short_name": "FitPlan",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#141413",
  "theme_color": "#141413",
  "lang": "de",
  "share_target": {
    "action": "./?share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
